# Supabase (server-side only). Leave unset to run in local JSON mode during `next dev`.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
IP_HASH_SALT=

# Credit Alien (iMessage coach)
ANTHROPIC_API_KEY=
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET_KEY=
# Shared secret you set on the webhook in Sendblue → Developer → Webhooks. Sent back as the sb-signing-secret header.
SENDBLUE_WEBHOOK_SECRET=
# Your Sendblue line, E.164. The public copy is what the website button dials.
SENDBLUE_NUMBER=+1
NEXT_PUBLIC_SENDBLUE_NUMBER=+1
# 1 = log outbound messages instead of calling Sendblue (local testing)
SENDBLUE_DRY_RUN=
# Random string; Vercel sends it as `Authorization: Bearer` on cron invocations
CRON_SECRET=
