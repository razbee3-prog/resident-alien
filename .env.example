# Supabase (server-side only). Leave unset to run in local JSON mode during `next dev`.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
IP_HASH_SALT=

# Credit Alien (iMessage coach)
# Anthropic: ANTHROPIC_API_KEY or ANTHROPIC_KEY
ANTHROPIC_API_KEY=
# Sendblue API credentials: SENDBLUE_API_KEY_ID or SENDBLUE_API_KEY / SENDBLUE_API_SECRET_KEY or SENDBLUE_SECRET
SENDBLUE_API_KEY=
SENDBLUE_SECRET=
# Optional; defaults to https://api.sendblue.com
SENDBLUE_BASE_URL=
# Your Sendblue line, E.164. Also what the website button dials.
SENDBLUE_NUMBER=+1
# Any random string. Set the same value on the webhook in Sendblue → Developer → Webhooks; it comes back as the sb-signing-secret header.
SENDBLUE_WEBHOOK_SECRET=
# Any random string. Vercel sends it as `Authorization: Bearer` when it invokes /api/cron/tick.
CRON_SECRET=
# 1 = log outbound messages instead of calling Sendblue (local testing)
SENDBLUE_DRY_RUN=
